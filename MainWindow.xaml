<Window x:Class="XmlTransformer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XML Transformer" Height="200" Width="600" ResizeMode="NoResize">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Label Content="Путь к XML файлу:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="FilePathTextBox" Width="380" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
            <Button x:Name="BrowseButton" Content="Обзор" Width="60" Click="BrowseButton_Click"/>
        </StackPanel>

        <Button Grid.Row="1" x:Name="MagicButton" Content="✨ Магия ✨" Width="120" Height="30" Click="MagicButton_Click" HorizontalAlignment="Center" Margin="0,10"/>

        <StatusBar Grid.Row="2" VerticalAlignment="Bottom" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>